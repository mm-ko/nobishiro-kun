# Database
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Docker Compose: host=db, port=5432. Match the root PostgreSQL settings.
DATABASE_URL=

# App environment: development or production (default: production)
APP_ENV=

# Development fixed user (#110): true only with APP_ENV=development.
# Requests without a token are treated as one fixed user. Never enable in production.
DEV_FIXED_USER_ENABLED=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# CORS
FRONTEND_ORIGIN=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=

# Test image upload
# 未指定の場合は、1枚10MB（10485760）、合計20MB（20971520）
IMAGE_MAX_BYTES=
IMAGE_TOTAL_MAX_BYTES=

# Usage limit (#23)
# 未指定の場合は、月10回（無料の2回を含む）
MONTHLY_ANALYSIS_LIMIT=

# Memcached
# Docker Composeではホスト名memcached、ポート11211を使用
MEMCACHED_HOST=
MEMCACHED_PORT=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
